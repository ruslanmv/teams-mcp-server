# Server
TEAMS_MCP_HOST=0.0.0.0
TEAMS_MCP_PORT=9106
TEAMS_MCP_LOG_LEVEL=INFO

# Microsoft Entra (Azure AD) app (Public client recommended for Device Code)
MS_TENANT_ID=common
MS_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID

# Token encryption (required)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEAMS_MCP_TOKEN_KEY=PLEASE_SET_A_FERNET_KEY

# Optional: restrict which account can be used
# MS_ALLOWED_UPN=you@domain.com
